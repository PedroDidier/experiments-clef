# Copy to .env and fill in the key for whichever provider you use.
# Only the key matching `model.provider` in your config file is required.

# provider: openai
OPENAI_API_KEY=

# provider: google  (Gemini / Gemma)
GOOGLE_API_KEY=

# provider: deepinfra  (Llama 4 Maverick / Scout)
DEEPINFRA_API_TOKEN=

# provider: anthropic  (Claude)
ANTHROPIC_API_KEY=

# Optional: override where HuggingFace models and datasets are cached.
# Defaults to ~/.cache/huggingface on Linux/macOS and to the drive letter in
# your config file on Windows.
# HF_HOME=/path/to/huggingface_cache
